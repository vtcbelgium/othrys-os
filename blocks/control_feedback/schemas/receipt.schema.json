{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "othrys/v2/control_feedback/receipt/1.0.0",
  "title": "OTHRYS V2 control feedback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "mission_id",
    "envelope_ref",
    "objective",
    "delegate",
    "created_at",
    "files_changed",
    "commands_run",
    "tests",
    "evidence",
    "result_claimed",
    "blocker",
    "repo_sha",
    "remote_sha",
    "sync_status",
    "next_state"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "receipt_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}--[0-9]{8}T[0-9]{6}Z$" },
    "mission_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "envelope_ref": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "delegate": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "change": { "type": "string", "enum": ["added", "modified", "deleted"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "exit_code"],
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "detail": { "type": "string" }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "result_claimed": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "FAILED"] },
    "blocker": { "type": ["string", "null"] },
    "repo_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "remote_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "sync_status": { "type": "string", "enum": ["NOT_SYNCED", "SYNCED", "PUSH_FAILED"] },
    "next_state": { "type": "string", "const": "WAIT_GPT" }
  }
}
