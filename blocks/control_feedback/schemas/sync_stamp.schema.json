{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "othrys/v2/control_feedback/sync_stamp/1.0.0",
  "title": "OTHRYS V2 remote sync proof stamp",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "receipt_ref",
    "remote",
    "repo_sha",
    "remote_sha",
    "blocker",
    "sync_status",
    "verified_at",
    "next_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "repo_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "remote_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "NOT_SYNCED",
        "SYNCED",
        "PUSH_FAILED"
      ]
    },
    "verified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "next_state": {
      "type": "string",
      "const": "WAIT_GPT"
    }
  }
}
