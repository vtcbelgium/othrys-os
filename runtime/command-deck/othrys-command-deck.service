[Unit]
Description=OTHRYS Command Deck read-only LAN surface
After=network-online.target othrys-mycelium.service

[Service]
Type=simple
EnvironmentFile=%h/.config/othrys/deck.env
WorkingDirectory=%h/othrys-v2-verify
ExecStart=/usr/bin/node %h/othrys-v2-verify/runtime/command-deck/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
