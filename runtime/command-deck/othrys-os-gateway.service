[Unit]
Description=OTHRYS OS gateway service
After=network-online.target othrys-mycelium-node.service
Conflicts=othrys-command-deck.service

[Service]
Type=simple
EnvironmentFile=%h/.config/othrys/deck.env
WorkingDirectory=%h/Othrys-Runtime/othrys-os-main
ExecStart=/usr/bin/node %h/Othrys-Runtime/othrys-os-main/runtime/command-deck/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
