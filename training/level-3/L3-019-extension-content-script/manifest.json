{
  "manifest_version": 3,
  "name": "L3-019 Content Script Tool",
  "version": "1.0",
  "description": "A bounded content script tool with minimal permissions.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "L3-019 Tool"
  }
}