s=\"field\">\n+          <span class=\"field-label\">Tags (comma separated)</span>\n+          <input\n+            id=\"block-tags\"\n+            type=\"text\"\n+            class=\"field-input\"\n+            aria-describedby=\"block-tags-help\"\n+          >\n+          <span id=\"block-tags-help\" class=\"field-help\">e.g. notes, draft, chapter</span>\n+        </div>\n+\n+        <button id=\"capture-btn\" type=\"submit\" class=\"btn btn-primary\">Capture block</button>\n+      </form>\n+    </section>\n+\n+    <section class=\"panel\" aria-labelledby=\"inventory-heading\">\n+      <div class=\"panel-head\">\n+        <h2 id=\"inventory-heading\">Inventory</h2>\n+        <p id=\"inventory-count\" class=\"inventory-count\" aria-live=\"polite\"></p>\n+      </div>\n+\n+      <div class=\"toolbar\">\n+        <label class=\"search\">\n+          <span class=\"search-label\">Search</span>\n+          <input id=\"search-input\" type=\"search\" class=\"search-input\" placeholder=\"Filter blocks…\" aria-label=\"Search blocks\">\n+        </label>\n+        <div class=\"toolbar-actions\">\n+          <button id=\"export-btn\" type=\"button\" class=\"btn btn-secondary\" disabled>Export JSON</button>\n+          <button id=\"import-btn\" type=\"button\" class=\"btn btn-secondary\" disabled>Import JSON</button>\n+          <input id=\"import-file\" type=\"file\" accept=\"application/json\" class=\"visually-hidden\" aria-hidden=\"true\">\n+        </div>\n+      </div>\n+\n+      <ul id=\"block-list\" class=\"block-list\" aria-labelledby=\"inventory-heading\">\n+        <li id=\"empty-state\" class=\"empty-state\" hidden>\n+          <p>No blocks captured yet.</p>\n+          <p class=\"muted\">Use the form above to capture your first block.</p>\n+        </li>\n+      </ul>\n+    </section>\n+  </main>\n+\n+  <div id=\"toast-region\" class=\"visually-hidden\" aria-live=\"assertive\" aria-atomic=\"true\"></div>\n+\n+  <script src=\"app.js\"></script>\n+</body>\n+</html>",
