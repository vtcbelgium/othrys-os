  "title": "Mnemosyne explicit project knowledge substrate",
  "objective": "Establish project-local capture, classification, review, deterministic search, maintenance and reconstructible export without opaque memory authority.",
  "scale": "EPIC",
  "problem": "OTHRYS exposes knowledge files but lacks a durable knowledge service and lifecycle comparable to Panda Atlas.",
  "outOfScope": [
    "No vector database",
    "No hidden model memory",
    "No automatic promotion to canonical truth",
    "No knowledge write API in Command Deck"
  ],
  "risks": [
    "Research is mistaken for canonical truth",
    "Search becomes non-reconstructible",
    "Knowledge paths escape project scope"
  ],
  "laws": [
    "Explicit files and records are the source of truth.",
    "Capture enters inbox only.",
    "Review never silently promotes knowledge.",
    "Search is deterministic and local in this mission.",
    "Maintenance reports issues but performs zero mutation.",
    "Export must be reconstructible and content-digest bound."
  ],
